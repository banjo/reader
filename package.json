{
    "name": "banjo-rss",
    "version": "1.0.0",
    "description": "",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "dev": "turbo dev",
        "clean": "pnpm run --parallel clean && rimraf node_modules",
        "knip": "knip",
        "build": "turbo build",
        "typecheck": "turbo typecheck",
        "web:build": "turbo build --filter web",
        "lint:all": "turbo lint",
        "format": "prettier --write .",
        "format:write": "prettier --write \"**/*.{ts,tsx,mdx}\" --cache",
        "db:build": "turbo build --filter db",
        "db:local:logs": "docker compose -f docker/docker-compose.yml logs --follow",
        "db:local:start": "docker compose -f docker/docker-compose.yml up -d --remove-orphans",
        "db:local:stop": "docker compose -f docker/docker-compose.yml down --remove-orphans",
        "db:local:reset": "pnpm --filter db db:reset",
        "db:reset": "./scripts/reset-db.sh",
        "deploy:api": "./scripts/deploy.sh banjo-rss-api",
        "deploy:worker": "./scripts/deploy.sh banjo-rss-worker",
        "logs:api": "./scripts/logs.sh banjo-rss-api",
        "logs:worker": "./scripts/logs.sh banjo-rss-worker"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@antfu/ni": "^30.6.0",
        "@banjoanton/eslint-config": "^0.2.20",
        "@banjoanton/prettier-config": "^0.1.11",
        "@ianvs/prettier-plugin-sort-imports": "^3.7.2",
        "eslint": "^9.39.5",
        "hoks": "^0.1.22",
        "knip": "^6.42.1",
        "pino-pretty": "^13.2.0",
        "prettier": "^3.9.10",
        "rimraf": "^6.1.3",
        "tsup": "^8.5.1",
        "tsx": "^4.23.15",
        "turbo": "^2.11.10",
        "typescript": "^5.9.3",
        "zx": "^7.2.3"
    },
    "prettier": "@banjoanton/prettier-config",
    "packageManager": "pnpm@8.6.3"
}
